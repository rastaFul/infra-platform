{
  "__inputs": [],
  "__elements": {},
  "__requires": [],
  "uid": "api-system-health",
  "title": "MicroGrow — API & System Health",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "tags": ["microgrow", "api", "system"],
  "panels": [
    {
      "id": 1,
      "title": "Requisições/min",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT $__dateBin(time) as time, sum(requests_total) as requests_total FROM api_metrics WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latência avg + p95 (ms)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT $__dateBin(time) as time, avg(avg_latency_ms) as avg_latency_ms, avg(p95_latency_ms) as p95_latency_ms FROM api_metrics WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Erros 5xx (últimos 30min)",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red",    "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT sum(errors_5xx) as errors_5xx FROM api_metrics WHERE time >= now() - INTERVAL '30 minutes'",
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Clientes MQTT Conectados",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 4, "y": 8, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green",  "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT value FROM mqtt_broker WHERE sys_topic = '$SYS/broker/clients/connected' AND time >= now() - INTERVAL '5 minutes' ORDER BY time DESC LIMIT 1",
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "title": "MQTT Messages Processed/interval",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 8, "y": 8, "w": 16, "h": 8 },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT $__dateBin(time) as time, sum(mqtt_messages_processed) as mqtt_messages_processed FROM api_metrics WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "Broker MQTT — Messages/min",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT time, CASE WHEN (value - lag(value) OVER (ORDER BY time)) < 0 THEN NULL ELSE (value - lag(value) OVER (ORDER BY time)) / (extract(epoch FROM time - lag(time) OVER (ORDER BY time)) / 60.0) END as messages_per_min FROM mqtt_broker WHERE sys_topic = '$SYS/broker/messages/received' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "CPU % por Processo",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT $__dateBin(time) as time, process_name, avg(cpu_usage) as cpu_usage FROM process_metrics WHERE $__timeFilter(time) GROUP BY 1, process_name ORDER BY 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 8,
      "title": "Memória RSS MB por Processo",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT $__dateBin(time) as time, process_name, avg(memory_rss) / 1048576.0 as memory_rss_mb FROM process_metrics WHERE $__timeFilter(time) GROUP BY 1, process_name ORDER BY 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 9,
      "title": "Erros Recentes da API",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki-platform" },
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki-platform" },
          "expr": "{service=\"microgrow-api\", level=\"error\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
