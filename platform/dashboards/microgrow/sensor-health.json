{
  "__inputs": [],
  "__elements": {},
  "__requires": [],
  "uid": "sensor-health",
  "title": "MicroGrow — Sensor Health",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "tags": ["microgrow", "sensors"],
  "panels": [
    {
      "id": 1,
      "title": "Status dos Sensores",
      "type": "table",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "age_s" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "displayName", "value": "Idade (s)" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green",  "value": null },
                    { "color": "yellow", "value": 30 },
                    { "color": "red",    "value": 300 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "vwc_pct" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "displayName", "value": "VWC %" }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"soil_moisture\")\n  |> filter(fn: (r) => r._field == \"vwc_pct\")\n  |> group(columns: [\"position\"])\n  |> last()\n  |> map(fn: (r) => ({\n      sensor: r.position,\n      type: \"solo\",\n      vwc_pct: r._value,\n      age_s: int(v: uint(v: now()) - uint(v: r._time)) / 1000000000\n    }))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Idade Sensor Solo — Center (s)",
      "type": "gauge",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 600,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red",    "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"api_metrics\")\n  |> filter(fn: (r) => r._field == \"sensor_age_soil_center_s\")\n  |> last()"
        }
      ]
    },
    {
      "id": 3,
      "title": "Idade Sensor Solo — Lateral (s)",
      "type": "gauge",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 4, "y": 8, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 600,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red",    "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"api_metrics\")\n  |> filter(fn: (r) => r._field == \"sensor_age_soil_lateral_s\")\n  |> last()"
        }
      ]
    },
    {
      "id": 4,
      "title": "Idade Sensor Solo — Opposite (s)",
      "type": "gauge",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 600,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red",    "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"api_metrics\")\n  |> filter(fn: (r) => r._field == \"sensor_age_soil_opposite_s\")\n  |> last()"
        }
      ]
    },
    {
      "id": 5,
      "title": "VWC 7 dias por sensor",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"soil_moisture\")\n  |> filter(fn: (r) => r._field == \"vwc_pct\")\n  |> aggregateWindow(every: 30m, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 6,
      "title": "ADC Raw — Calibração (drift)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"soil_moisture\")\n  |> filter(fn: (r) => r._field == \"raw\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 7,
      "title": "VPD Canopy 7d",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pressurekpa",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",   "value": null },
              { "color": "green",  "value": 0.8 },
              { "color": "yellow", "value": 1.5 },
              { "color": "red",    "value": 2.0 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"air_conditions\")\n  |> filter(fn: (r) => r.position == \"canopy\")\n  |> filter(fn: (r) => r._field == \"vpd_kpa\")\n  |> aggregateWindow(every: 1h, fn: mean, createEmpty: false)"
        }
      ]
    }
  ]
}
