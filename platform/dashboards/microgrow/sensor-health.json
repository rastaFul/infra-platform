{
  "__inputs": [],
  "__elements": {},
  "__requires": [],
  "uid": "sensor-health",
  "title": "MicroGrow — Sensor Health",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "tags": ["microgrow", "sensors"],
  "panels": [
    {
      "id": 1,
      "title": "Status dos Sensores",
      "type": "table",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "age_s" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "displayName", "value": "Idade (s)" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green",  "value": null },
                    { "color": "yellow", "value": 30 },
                    { "color": "red",    "value": 300 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "vwc_pct" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "displayName", "value": "VWC %" }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT position as sensor, 'solo' as type, vwc_pct, extract(epoch FROM now() - time) as age_s FROM (SELECT position, vwc_pct, time, ROW_NUMBER() OVER (PARTITION BY position ORDER BY time DESC) as rn FROM soil_moisture WHERE time >= now() - INTERVAL '10 minutes') t WHERE rn = 1",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "title": "Idade Sensor Solo — Center (s)",
      "type": "gauge",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 600,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red",    "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT sensor_age_soil_center_s FROM api_metrics WHERE time >= now() - INTERVAL '10 minutes' ORDER BY time DESC LIMIT 1",
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "title": "Idade Sensor Solo — Lateral (s)",
      "type": "gauge",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 4, "y": 8, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 600,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red",    "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT sensor_age_soil_lateral_s FROM api_metrics WHERE time >= now() - INTERVAL '10 minutes' ORDER BY time DESC LIMIT 1",
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Idade Sensor Solo — Opposite (s)",
      "type": "gauge",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 600,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red",    "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT sensor_age_soil_opposite_s FROM api_metrics WHERE time >= now() - INTERVAL '10 minutes' ORDER BY time DESC LIMIT 1",
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "title": "VWC 7 dias por sensor",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT date_bin(INTERVAL '30 minutes', time) as time, position, avg(vwc_pct) as vwc_pct FROM soil_moisture WHERE time >= now() - INTERVAL '7 days' GROUP BY 1, position ORDER BY 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "ADC Raw — Calibração (drift)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT $__dateBin(time) as time, position, avg(raw) as raw FROM soil_moisture WHERE $__timeFilter(time) GROUP BY 1, position ORDER BY 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "VPD Canopy 7d",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pressurekpa",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",   "value": null },
              { "color": "green",  "value": 0.8 },
              { "color": "yellow", "value": 1.5 },
              { "color": "red",    "value": 2.0 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "rawSql": "SELECT date_bin(INTERVAL '1 hour', time) as time, avg(vpd_kpa) as vpd_kpa FROM air_conditions WHERE position = 'canopy' AND time >= now() - INTERVAL '7 days' GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ]
    }
  ]
}
