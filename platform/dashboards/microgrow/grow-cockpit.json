{
  "__inputs": [],
  "__elements": {},
  "__requires": [],
  "uid": "grow-cockpit",
  "title": "MicroGrow — Grow Cockpit",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "tags": ["microgrow", "cockpit"],
  "panels": [
    {
      "id": 1,
      "title": "Row: Estado Atual",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 2,
      "title": "Hydric Score",
      "type": "gauge",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"hydric_score\")\n  |> filter(fn: (r) => r._field == \"score\")\n  |> last()"
        }
      ]
    },
    {
      "id": 3,
      "title": "Decisão Atual",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "string",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "HOLD":      { "color": "blue",  "index": 0 },
                "IRRIGATE":  { "color": "green", "index": 1 },
                "BLOCKED":   { "color": "red",   "index": 2 }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"hydric_score\")\n  |> filter(fn: (r) => r._field == \"score\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: r.decision}))"
        }
      ]
    },
    {
      "id": 4,
      "title": "VWC Médio %",
      "type": "gauge",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 6 },
      "options": {
        "reduceOptions": { "calcs": ["mean"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "yellow", "value": 40 },
              { "color": "green",  "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r._measurement == \"soil_moisture\")\n  |> filter(fn: (r) => r._field == \"vwc_pct\")\n  |> mean()"
        }
      ]
    },
    {
      "id": 5,
      "title": "Reservatório %",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "yellow", "value": 25 },
              { "color": "green",  "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r._measurement == \"reservoir\")\n  |> filter(fn: (r) => r._field == \"level_pct\")\n  |> last()"
        }
      ]
    },
    {
      "id": 6,
      "title": "Próxima Rega (h)",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r._measurement == \"hydric_score\")\n  |> filter(fn: (r) => r._field == \"next_irrigation_est_h\")\n  |> last()"
        }
      ]
    },
    {
      "id": 7,
      "title": "Velocidade Simulação",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "mappings": [],
          "custom": {
            "displayName": "${__value.text}x"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r._measurement == \"api_metrics\")\n  |> filter(fn: (r) => r._field == \"sim_speed\")\n  |> last()"
        }
      ]
    },
    {
      "id": 10,
      "title": "Row: Sensores — Últimas 6h",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 1 }
    },
    {
      "id": 11,
      "title": "VWC Sensores de Solo",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "orange", "value": 40 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"soil_moisture\")\n  |> filter(fn: (r) => r._field == \"vwc_pct\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 12,
      "title": "Hydric Score + Componentes",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "score" },
            "properties": [
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"hydric_score\")\n  |> filter(fn: (r) => contains(value: r._field, set: [\"score\", \"components_moisture\", \"components_drying\", \"components_time\", \"components_temp\"]))\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)"
        }
      ]
    },
    {
      "id": 13,
      "title": "Temperatura + VPD (Canopy)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "temp_c" },
            "properties": [
              { "id": "unit", "value": "celsius" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "vpd_kpa" },
            "properties": [
              { "id": "unit", "value": "pressurekpa" }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"air_conditions\")\n  |> filter(fn: (r) => r.position == \"canopy\")\n  |> filter(fn: (r) => contains(value: r._field, set: [\"temp_c\", \"vpd_kpa\"]))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 14,
      "title": "Nível Reservatório",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "red",    "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"reservoir\")\n  |> filter(fn: (r) => r._field == \"level_pct\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)"
        }
      ]
    },
    {
      "id": 20,
      "title": "Row: Irrigação",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 1 }
    },
    {
      "id": 21,
      "title": "Irrigações Hoje",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 0, "y": 25, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red",    "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"pump_events\")\n  |> filter(fn: (r) => r._field == \"active\")\n  |> filter(fn: (r) => r._value == true)\n  |> count()"
        }
      ]
    },
    {
      "id": 22,
      "title": "Eventos de Irrigação (24h)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
      "gridPos": { "x": 4, "y": 25, "w": 20, "h": 8 },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 30,
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-microgrow" },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"pump_events\")\n  |> filter(fn: (r) => r._field == \"active\")\n  |> aggregateWindow(every: 1h, fn: count, createEmpty: true)"
        }
      ]
    }
  ]
}
