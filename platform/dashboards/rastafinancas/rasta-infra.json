  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API Process CPU %",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-rastafinancas"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-rastafinancas"
          },
          "rawSql": "SELECT date_bin($__interval, time) AS time, AVG(counter) AS value\nFROM procstat_cpu_usage\nWHERE $__timeFilter(time) AND service = 'api'\nGROUP BY 1\nORDER BY 1",
          "format": "time_series"
        }
      ]
    },
