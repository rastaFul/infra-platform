          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-rastafinancas"
          },
          "query": "from(bucket: \"rastafinancas\")\n  |> range(start: -1m, stop: now())\n  |> filter(fn: (r) => r[\"_measurement\"] == \"http_response_result_code\")\n  |> filter(fn: (r) => r[\"_field\"] == \"counter\")\n  |> filter(fn: (r) => r[\"probe\"] == \"api-local\")\n  |> map(fn: (r) => ({ r with _value: 99.5 }))\n  |> last()\n  |> yield(name: \"slo_target\")"
