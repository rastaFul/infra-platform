  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API Uptime % (30d)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-rastafinancas"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-rastafinancas"
          },
          "query": "total = from(bucket: \"rastafinancas\")\n  |> range(start: -30d, stop: now())\n  |> filter(fn: (r) => r[\"_measurement\"] == \"http_response_result_code\")\n  |> filter(fn: (r) => r[\"_field\"] == \"counter\")\n  |> filter(fn: (r) => r[\"probe\"] == \"api-local\")\n  |> count()\n\nup = from(bucket: \"rastafinancas\")\n  |> range(start: -30d, stop: now())\n  |> filter(fn: (r) => r[\"_measurement\"] == \"http_response_result_code\")\n  |> filter(fn: (r) => r[\"_field\"] == \"counter\")\n  |> filter(fn: (r) => r[\"probe\"] == \"api-local\")\n  |> filter(fn: (r) => r[\"_value\"] == 0)\n  |> count()\n\nunion(tables: [up, total])\n  |> yield(name: \"api_uptime_pct\")"
        }
      ]
    },
