          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-rastafinancas"
          },
          "rawSql": "SELECT date_bin($__interval, time) AS time, AVG(response_time * 1000) AS value\nFROM http_response\nWHERE $__timeFilter(time) AND probe = 'api-local'\nGROUP BY 1\nORDER BY 1",
          "format": "time_series"
        }
