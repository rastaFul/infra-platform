  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Data Writes/h",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-rastafinancas"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-rastafinancas"
          },
          "rawSql": "WITH deltas AS (\n  SELECT date_bin($__interval, time) AS time,\n    counter - LAG(counter) OVER (ORDER BY time) AS delta,\n    EXTRACT(EPOCH FROM (time - LAG(time) OVER (ORDER BY time))) AS dt\n  FROM rasta_data_ops_total\n  WHERE $__timeFilter(time) AND op = 'write'\n)\nSELECT time, AVG(delta / dt * 3600) AS value\nFROM deltas\nWHERE dt > 0 AND delta >= 0\nGROUP BY time\nORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
