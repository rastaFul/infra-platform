      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-rastafinancas"
          },
          "rawSql": "WITH deltas AS (\n  SELECT date_bin($__interval, time) AS time,\n    counter - LAG(counter) OVER (ORDER BY time) AS delta,\n    EXTRACT(EPOCH FROM (time - LAG(time) OVER (ORDER BY time))) AS dt\n  FROM rasta_data_ops_total\n  WHERE $__timeFilter(time) AND op = 'read'\n)\nSELECT time, AVG(delta / dt * 60) AS reads\nFROM deltas\nWHERE dt > 0 AND delta >= 0\nGROUP BY time\nORDER BY time",
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-rastafinancas"
          },
          "rawSql": "WITH deltas AS (\n  SELECT date_bin($__interval, time) AS time,\n    counter - LAG(counter) OVER (ORDER BY time) AS delta,\n    EXTRACT(EPOCH FROM (time - LAG(time) OVER (ORDER BY time))) AS dt\n  FROM rasta_data_ops_total\n  WHERE $__timeFilter(time) AND op = 'write'\n)\nSELECT time, AVG(delta / dt * 60) AS writes\nFROM deltas\nWHERE dt > 0 AND delta >= 0\nGROUP BY time\nORDER BY time",
          "format": "time_series"
        }
      ]
