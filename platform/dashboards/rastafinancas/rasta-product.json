            "uid": "influxdb-rastafinancas"
          },
          "query": "from(bucket: \"rastafinancas\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"rasta_data_ops_total\")\n  |> filter(fn: (r) => r[\"_field\"] == \"counter\")\n  |> filter(fn: (r) => r[\"op\"] == \"read\")\n  |> derivative(unit: 1m, nonNegative: true)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> set(key: \"_field\", value: \"reads\")\n  |> yield(name: \"reads\")"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
