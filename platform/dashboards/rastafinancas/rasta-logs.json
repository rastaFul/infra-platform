        "wrapLogMessage": false
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-platform"
          },
          "expr": "{app=\"rastafinancas\"}",
          "queryType": "range",
          "maxLines": 200
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Error Logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-platform"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-platform"
          },
          "expr": "{app=\"rastafinancas\", level=\"error\"}",
          "queryType": "range",
          "maxLines": 100
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Log Volume/h",
      "datasource": {
        "type": "loki",
        "uid": "loki-platform"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-platform"
          },
          "expr": "sum by (level) (count_over_time({app=\"rastafinancas\"}[1h]))",
          "queryType": "range",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "5xx Requests",
      "datasource": {
        "type": "loki",
        "uid": "loki-platform"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "options": {
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Time"
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-platform"
          },
          "expr": "{app=\"rastafinancas\"} |= \"5\" | json | status >= 500",
          "queryType": "range",
          "maxLines": 100,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels"
          }
        }
      ]
    }
  ],
