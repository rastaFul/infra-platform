  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Live Log Stream",
      "datasource": {
        "type": "loki",
        "uid": "loki-platform"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
