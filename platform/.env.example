# ── InfluxDB ──────────────────────────────────────────────────────────
INFLUXDB_ADMIN_PASSWORD=change_me_strong_password_here
# Admin token — used for setup. For production, create scoped tokens.
INFLUXDB_ADMIN_TOKEN=change_me_influx_admin_token_64chars_minimum

# Per-project tokens (can equal INFLUXDB_ADMIN_TOKEN locally, must be scoped in prod)
INFLUXDB_TOKEN_MICROGROW=change_me_influx_admin_token_64chars_minimum
INFLUXDB_TOKEN_RASTAFINANCAS=change_me_influx_admin_token_64chars_minimum
INFLUXDB_TOKEN_GRAFANA=change_me_influx_admin_token_64chars_minimum

# ── Grafana ───────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password

# ── GlitchTip ─────────────────────────────────────────────────────────
GLITCHTIP_DB_PASSWORD=change_me_glitchtip_db_password
# SECRET_KEY: generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
GLITCHTIP_SECRET_KEY=change_me_generate_with_python3_secrets_token_hex_32
GLITCHTIP_DOMAIN=http://localhost:8010

# ── SMTP (Grafana alerting) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com:587
SMTP_FROM=noreply@rastaful.dev
