# Copy to terraform.tfvars (gitignored) and fill in with real values once
# the Oracle Cloud account exists. Never commit terraform.tfvars.

compartment_id      = "ocid1.compartment.oc1..REPLACE_ME"   # root compartment OCID, or a dedicated sub-compartment
region               = "eu-frankfurt-1"                      # non-US, see ADR 007 (ARM free-shape capacity)
availability_domain  = "REPLACE_ME:EU-FRANKFURT-1-AD-1"       # `oci iam availability-domain list`
ssh_public_key       = "ssh-ed25519 AAAA... your-key-here"    # break-glass access only, Coolify is the normal path
operator_cidr        = "REPLACE_ME.REPLACE_ME.REPLACE_ME.REPLACE_ME/32"  # your own IP, never 0.0.0.0/0
